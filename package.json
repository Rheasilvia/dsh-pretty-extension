{
  "name": "dsh-pretty-extension",
  "version": "0.3.2",
  "icon": "docs/images/icon-512.png",
  "homepage": "https://github.com/Rheasilvia/dsh-pretty-extension#readme",
  "bugs": {
    "url": "https://github.com/Rheasilvia/dsh-pretty-extension/issues"
  },
  "description": "DeepSeek Harness Web UI beautification plugin with a dedicated Pretty settings section.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsdown",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "check:dist": "pnpm run build && node scripts/check-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib",
    "docs/images",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "axe-core": "^4.10.3",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.0-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rheasilvia/dsh-pretty-extension.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "web-ui",
    "theme",
    "theme-editor",
    "themes",
    "customization"
  ]
}
